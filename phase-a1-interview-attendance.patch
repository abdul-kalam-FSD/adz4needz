+
+// ---- the real Express app: authentication, role and the JSON guard (in-memory repositories) ----
+const config = { cookieName: 'bde_session', cookieSecure: false, sessionTtlHours: 8, trustProxy: false, loginRateLimitMax: 1000, chatSendRateLimitMax: 1000, receiptMaxBytes: 1024 * 1024, importMaxBytes: 1024 * 1024 };
+let server; let base; let repo; const users = []; const sessions = new Map();
+before(async () => {
+  users.push(
+    { id: 1, employee_id: 'ADM-1', name: 'Admin One', role: 'admin', is_active: 1, password_hash: await hashPassword('admin-password-1') },
+    { id: 10, employee_id: 'BDE-10', name: 'Bde Ten', role: 'bde', is_active: 1, password_hash: await hashPassword('bde-password-10') }
