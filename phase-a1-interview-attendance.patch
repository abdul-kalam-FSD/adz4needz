+// Phase A1: the admin "Attended / Did not come" action. Service rules, the SQL text, the real Express route (authentication, role, JSON guard)
+// and the wiring. The database is replaced by in-memory fakes, so this is NOT a MySQL test: the real UPDATE has never run against MySQL.
+import test, { before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { createApp } from '../src/app.js';
+import { createAuthService } from '../src/modules/auth/auth.service.js';
+import { createInterviewService } from '../src/modules/interviews/interviews.service.js';
+import { createInterviewRepository } from '../src/modules/interviews/interviews.repository.js';
+import { hashPassword } from '../src/lib/password.js';
+import { hashToken } from '../src/lib/session-token.js';
+
+const admin = { id: 1, role: 'admin', employeeId: 'ADM-1', name: 'Admin One' };
+const bde = (id) => ({ id, role: 'bde', employeeId: 'E' + id, name: 'BDE ' + id });
+
+// In-memory stand-in for the repository. setAttendance mirrors the SQL guard (outcome must be pending unless attending).
+function fakeRepo(seed) {
+  const rows = (seed || [
+    { id: 1, lead_id: 100, user_id: 10, scheduled_at: '2026-10-18 11:00:00', attendance: 'pending', outcome: 'pending', interested_in_joining: null },
+    { id: 2, lead_id: 101, user_id: 11, scheduled_at: '2026-10-10 10:00:00', attendance: 'attended', outcome: 'selected', interested_in_joining: 1 },
+    { id: 3, lead_id: 102, user_id: 10, scheduled_at: '2026-10-12 10:00:00', attendance: 'did_not_attend', outcome: 'pending', interested_in_joining: null }
+  ]).map((r) => ({ created_at: 'c', updated_at: 'u', ...r }));
+  const writes = []; let hook = null;
+  const joined = (i) => ({ ...i, bde_employee_id: 'E' + i.user_id, bde_name: 'BDE ' + i.user_id, payment_confirmed: 0, candidate_name: 'Cand ' + i.lead_id, phone: '9', email: null, course_or_internship: 'Data' });
+  return {
+    rows, writes, beforeWrite: (fn) => { hook = fn; },
+    findById: async (id, scope) => { const i = rows.find((r) => String(r.id) === String(id) && (scope == null || r.user_id === scope)); return i ? joined(i) : null; },
+    setAttendance: async (id, attendance) => {
+      if (hook) hook(rows);
+      const i = rows.find((r) => String(r.id) === String(id));
+      if (!i || !(attendance === 'attended' || i.outcome === 'pending')) return 0;
+      writes.push(['setAttendance', String(id), attendance]); i.attendance = attendance; i.updated_at = 'u2'; return 1;
+    },
+    update: async (id, userId, v) => { const i = rows.find((r) => r.id === Number(id) && r.user_id === userId); if (!i) return; writes.push(['update', id]); Object.assign(i, { attendance: v.attendance, outcome: v.outcome }); },
+    findOwnLead: async () => null, insert: async () => 0
+  };
+}
+const make = (seed) => { const repo = fakeRepo(seed); return { repo, svc: createInterviewService({ repo }) }; };
+const status = (p, s, code) => assert.rejects(p, (e) => e.status === s && (code === undefined || e.code === code));
+
+test('service: only an ADMIN can use it; a BDE (even the owner), unknown roles and no user get 403 and nothing is written', async () => {
+  const { repo, svc } = make();
+  for (const actor of [bde(10), bde(11), { id: 9, role: 'other' }, null, undefined]) await status(svc.setAttendance(actor, '1', { attendance: 'attended' }), 403, 'FORBIDDEN');
+  assert.deepEqual(repo.writes, []);
+  assert.equal(repo.rows[0].attendance, 'pending');
+});
+
+test('service: Attended and Did not come are saved; only attendance changes; the admin sees the BDE', async () => {
+  const { repo, svc } = make();
+  let i = await svc.setAttendance(admin, '1', { attendance: 'attended' });
+  assert.equal(i.attendance, 'attended'); assert.equal(i.outcome, 'pending'); assert.equal(i.bde.employeeId, 'E10');
+  assert.equal(i.scheduledAt, '2026-10-18T11:00'); assert.equal(repo.rows[0].interested_in_joining, null);
+  i = await svc.setAttendance(admin, '1', { attendance: 'did_not_attend' });
+  assert.equal(i.attendance, 'did_not_attend'); assert.deepEqual(repo.writes, [['setAttendance', '1', 'attended'], ['setAttendance', '1', 'did_not_attend']]);
+});
+
+test('service: an admin may correct a value the BDE entered (Did not come -> Attended), and repeating the same value is harmless', async () => {
+  const { repo, svc } = make();
+  assert.equal((await svc.setAttendance(admin, '3', { attendance: 'attended' })).attendance, 'attended');
+  assert.equal((await svc.setAttendance(admin, '3', { attendance: 'attended' })).attendance, 'attended');
+  assert.equal(repo.rows[2].outcome, 'pending');
+});
+
+test('service: invalid input -> 400 with the field, nothing written (pending is not allowed, nor wrong types)', async () => {
+  const { repo, svc } = make();
+  for (const body of [undefined, null, [], 'attended', {}, { attendance: '' }, { attendance: null }, { attendance: 'pending' }, { attendance: 'present' }, { attendance: 'ATTENDED' }, { attendance: true }, { attendance: ['attended'] }, { attendance: {} }]) {
+    await assert.rejects(svc.setAttendance(admin, '1', body), (e) => e.status === 400 && e.code === 'VALIDATION_ERROR' && Boolean(e.fields && e.fields.attendance), JSON.stringify(body));
+  }
+  for (const id of ['abc', '0', '-1', '1.5', '', ' 1', '1; DROP TABLE interviews', '1'.repeat(30), undefined, 5]) await status(svc.setAttendance(admin, id, { attendance: 'attended' }), 400, 'VALIDATION_ERROR');
+  assert.deepEqual(repo.writes, []);
+});
+
+test('service: a missing interview is 404 and nothing is written', async () => {
+  const { repo, svc } = make();
+  await status(svc.setAttendance(admin, '999', { attendance: 'attended' }), 404, 'NOT_FOUND');
+  assert.deepEqual(repo.writes, []);
+});
+
+test('service: existing rule kept - "Did not come" is refused (409) while a Selected / Not selected outcome is recorded; "Attended" is fine', async () => {
+  const { repo, svc } = make();
+  await status(svc.setAttendance(admin, '2', { attendance: 'did_not_attend' }), 409, 'OUTCOME_RECORDED');
+  assert.equal(repo.rows[1].attendance, 'attended'); assert.equal(repo.rows[1].outcome, 'selected'); assert.deepEqual(repo.writes, []);
+  assert.equal((await svc.setAttendance(admin, '2', { attendance: 'attended' })).outcome, 'selected');
+});
+
+test('service: an outcome recorded between the read and the write is not overwritten (409), and the data stays consistent', async () => {
+  const { repo, svc } = make();
+  repo.beforeWrite((rows) => { rows[0].attendance = 'attended'; rows[0].outcome = 'not_selected'; }); // the BDE saves an outcome at that moment
+  await status(svc.setAttendance(admin, '1', { attendance: 'did_not_attend' }), 409, 'OUTCOME_RECORDED');
+  assert.equal(repo.rows[0].attendance, 'attended'); assert.equal(repo.rows[0].outcome, 'not_selected');
+});
+
+test('service: the row deleted between the read and the write -> 404; a driver that reports 0 rows for an unchanged value still succeeds', async () => {
+  const gone = make(); gone.repo.beforeWrite((rows) => { rows.length = 0; });
+  await status(gone.svc.setAttendance(admin, '1', { attendance: 'attended' }), 404, 'NOT_FOUND');
+  const repo = fakeRepo(); repo.setAttendance = async () => 0; // e.g. no "found rows" flag: unchanged value reports 0
+  const svc = createInterviewService({ repo });
+  repo.rows[0].attendance = 'attended';
+  assert.equal((await svc.setAttendance(admin, '1', { attendance: 'attended' })).attendance, 'attended');
+  await status(svc.setAttendance(admin, '1', { attendance: 'did_not_attend' }), 409, 'CHANGED_CONCURRENTLY');
+});
+
+test('service: the BDE workflow is unchanged - the owner still edits, another BDE gets 404, the admin still cannot create or edit', async () => {
+  const { repo, svc } = make();
+  const full = { scheduledAt: '2026-10-18T11:00', attendance: 'attended', outcome: 'pending', interestedInJoining: null };
+  assert.equal((await svc.update(bde(10), '1', full)).attendance, 'attended');
+  await status(svc.update(bde(11), '1', full), 404, 'NOT_FOUND');
+  await status(svc.update(admin, '1', full), 403, 'FORBIDDEN');
+  await status(svc.create(admin, { leadId: 100, scheduledAt: '2026-10-18T11:00' }), 403, 'FORBIDDEN');
+  assert.deepEqual(repo.writes, [['update', '1']]);
+});
+
+test('repository SQL: changes only attendance and updated_at; every value is a placeholder; the guard repeats the outcome rule; the result is the matched row count', async () => {
+  const calls = [];
+  const repo = createInterviewRepository({ query: async (sql, params) => { calls.push({ sql: sql.replace(/\s+/g, ' ').trim(), params }); return { affectedRows: 1 }; } });
+  assert.equal(await repo.setAttendance('7', 'did_not_attend'), 1);
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0].sql, "UPDATE interviews SET attendance = ?, updated_at = UTC_TIMESTAMP() WHERE id = ? AND (? = 'attended' OR outcome = 'pending')");
+  assert.deepEqual(calls[0].params, ['did_not_attend', '7', 'did_not_attend']);
+  const evil = createInterviewRepository({ query: async (sql, params) => { calls.push({ sql, params }); return { affectedRows: 0 }; } });
+  assert.equal(await evil.setAttendance("1' OR '1'='1", 'attended'), 0);
+  assert.ok(!calls.at(-1).sql.includes('OR \'1\''), 'input never reaches the SQL text');
+  const odd = createInterviewRepository({ query: async () => undefined });
+  assert.equal(await odd.setAttendance('1', 'attended'), null, 'unrecognised driver result is not mistaken for success');
+});
+
+test('wiring (text): one PUT route on a separate admin-only router before the /admin guard; adminRouter stays read-only; no migration or schema file touched', () => {
+  const app = readFileSync(new URL('../src/app.js', import.meta.url), 'utf8');
+  assert.match(app, /api\.use\('\/admin\/interviews', authenticate, authorize\('admin'\), interviewAttendanceRouter\)/);
+  assert.equal((app.match(/interviewAttendanceRouter\.\w+\(/g) || []).length, 1); assert.match(app, /interviewAttendanceRouter\.put\('\/:id\/attendance'/);
+  assert.ok(app.indexOf("api.use('/admin/interviews'") < app.indexOf("api.use('/admin', authenticate"));
+  assert.equal((app.match(/adminRouter\.(post|put|patch|delete)\(/g) || []).length, 0);
+  const repoSrc = readFileSync(new URL('../src/modules/interviews/interviews.repository.js', import.meta.url), 'utf8');
+  assert.equal((repoSrc.match(/\b(INSERT|DELETE|ALTER|DROP|TRUNCATE|CREATE)\b/g) || []).length, 1, 'only the pre-existing INSERT INTO interviews');
