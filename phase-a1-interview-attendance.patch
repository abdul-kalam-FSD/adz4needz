diff --git a/frontend/src/lib/interview-attendance.js b/frontend/src/lib/interview-attendance.js
new file mode 100644
index 0000000..fc9b431
--- /dev/null
+++ b/frontend/src/lib/interview-attendance.js
@@ -0,0 +1,22 @@
+// Admin "Attended / Did not come" buttons for one interview row. Mirrors the server rule (the server is the real check):
+// an outcome (Selected / Not selected) needs attendance = attended, so "Did not come" is unavailable while an outcome is recorded.
+export const ADMIN_ATTENDANCE_ACTIONS = [['attended', 'Attended'], ['did_not_attend', "Didn't come"]];
+export const OUTCOME_BLOCK_REASON = 'A Selected / Not selected outcome is recorded. The BDE must change the outcome first.';
+
+// -> [{ value, label, current, disabled, reason }]
+export function attendanceActions(interview, { busy = false } = {}) {
+  return ADMIN_ATTENDANCE_ACTIONS.map(([value, label]) => {
+    const current = interview.attendance === value;
+    const blocked = value === 'did_not_attend' && interview.outcome !== 'pending';
+    return { value, label, current, disabled: busy || current || blocked, reason: blocked && !current ? OUTCOME_BLOCK_REASON : '' };
+  });
+}
+
+// Replaces one interview inside a loaded list page without touching the others (a new object; the input is not changed).
+export function replaceInterview(list, updated) {
+  if (!list || !Array.isArray(list.interviews)) return list;
+  return { ...list, interviews: list.interviews.map((i) => (i.id === updated.id ? { ...i, attendance: updated.attendance, outcome: updated.outcome, state: i.state === 'needs_update' && updated.attendance !== 'pending' ? null : i.state } : i)) };
+}
+
+// Admin tabs: [label, value of the existing "when" filter]. "All" = no filter, which is how the page already opens.
+export const ADMIN_INTERVIEW_TABS = [['Today', 'today'], ['Upcoming', 'upcoming'], ['Past', 'past'], ['All', '']];
diff --git a/frontend/src/lib/interview-attendance.test.js b/frontend/src/lib/interview-attendance.test.js
new file mode 100644
index 0000000..dcf0da8
--- /dev/null
+++ b/frontend/src/lib/interview-attendance.test.js
@@ -0,0 +1,41 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { attendanceActions, replaceInterview, ADMIN_INTERVIEW_TABS, OUTCOME_BLOCK_REASON } from './interview-attendance.js';
+
+const row = (o = {}) => ({ id: 1, attendance: 'pending', outcome: 'pending', state: null, ...o });
+
+test('pending interview: both actions are available', () => {
+  const [a, d] = attendanceActions(row());
+  assert.deepEqual([a.value, a.disabled, a.current], ['attended', false, false]); assert.deepEqual([d.value, d.disabled, d.current], ['did_not_attend', false, false]);
+});
+test('the current value is marked and disabled; the other stays available (the admin can correct it)', () => {
+  const [a, d] = attendanceActions(row({ attendance: 'attended' }));
+  assert.equal(a.current, true); assert.equal(a.disabled, true); assert.equal(d.disabled, false);
+});
+test('"Didn\'t come" is unavailable with the reason while an outcome is recorded; "Attended" is not', () => {
+  const [a, d] = attendanceActions(row({ attendance: 'attended', outcome: 'selected' }));
+  assert.equal(d.disabled, true); assert.equal(d.reason, OUTCOME_BLOCK_REASON); assert.equal(a.reason, '');
+  assert.equal(attendanceActions(row({ attendance: 'pending', outcome: 'not_selected' }))[1].disabled, true);
+});
+test('while a request is running every button is disabled', () => { assert.ok(attendanceActions(row(), { busy: true }).every((x) => x.disabled)); });
+test('replaceInterview changes only that row and clears the "Update attendance" hint once attendance is set; input is not mutated', () => {
+  const list = { total: 2, interviews: [row({ id: 1, state: 'needs_update' }), row({ id: 2 })] };
+  const next = replaceInterview(list, { id: 1, attendance: 'did_not_attend', outcome: 'pending' });
+  assert.equal(next.interviews[0].attendance, 'did_not_attend'); assert.equal(next.interviews[0].state, null);
+  assert.equal(next.interviews[1], list.interviews[1]); assert.equal(list.interviews[0].attendance, 'pending'); assert.equal(next.total, 2);
+  assert.equal(replaceInterview(null, { id: 1 }), null);
+  const today = replaceInterview({ interviews: [row({ id: 3, state: 'today' })] }, { id: 3, attendance: 'attended', outcome: 'pending' });
+  assert.equal(today.interviews[0].state, 'today');
+});
+test('tabs: Today / Upcoming / Past / All map onto the "when" filter values the server accepts', () => {
+  assert.deepEqual(ADMIN_INTERVIEW_TABS.map((t) => t[0]), ['Today', 'Upcoming', 'Past', 'All']);
+  assert.deepEqual(ADMIN_INTERVIEW_TABS.map((t) => t[1]), ['today', 'upcoming', 'past', '']);
+});
+test('wiring (text): the client calls PUT /admin/interviews/:id/attendance; the list shows the actions in admin mode only', () => {
+  const client = readFileSync(new URL('../api/client.js', import.meta.url), 'utf8');
+  assert.match(client, /adminSetInterviewAttendance: \(id, attendance\) => request\('PUT', '\/admin\/interviews\/' \+ encodeURIComponent\(id\) \+ '\/attendance', \{ attendance \}\)/);
+  const view = readFileSync(new URL('../components/InterviewsListView.jsx', import.meta.url), 'utf8');
+  assert.match(view, /admin && <td>[\s\S]*attendanceActions/); assert.match(view, /api\.adminSetInterviewAttendance\(/);
+  assert.match(view, /\{!admin && <td><Link to=\{`\/interviews\/\$\{i\.id\}\/edit`\}>Edit<\/Link><\/td>\}/, 'BDE Edit link unchanged');
+});
