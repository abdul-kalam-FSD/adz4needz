+  assert.equal(bad.status, 400); assert.equal(bad.json.error.code, 'VALIDATION_ERROR'); assert.ok(bad.json.error.fields.attendance);
+  assert.equal((await call('PUT', '/api/admin/interviews/abc/attendance', { body: { attendance: 'attended' }, cookie })).status, 400);
+  const missing = await call('PUT', '/api/admin/interviews/999/attendance', { body: { attendance: 'attended' }, cookie });
