+    deleteSessionByHash: async (h) => { sessions.delete(h); }, deleteExpiredSessionsForUser: async () => {}
+  };
+  repo = fakeRepo();
+  const app = createApp({ config, authService: createAuthService({ repo: authRepo, ttlHours: 8 }), interviewService: createInterviewService({ repo }), checkDb: async () => {} });
+  await new Promise((resolve) => { server = app.listen(0, '127.0.0.1', resolve); });
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+after(async () => { await new Promise((resolve) => server.close(resolve)); });
+
+async function call(method, path, { body, cookie, contentType = 'application/json' } = {}) {
+  const res = await fetch(base + path, { method, headers: { ...(body !== undefined ? { 'content-type': contentType } : {}), ...(cookie ? { cookie } : {}) }, body: body === undefined ? undefined : (typeof body === 'string' ? body : JSON.stringify(body)) });
+  const text = await res.text(); let json = null; try { json = JSON.parse(text); } catch { /* not JSON */ }
+  const sc = res.headers.get('set-cookie');
+  return { status: res.status, json, cookie: sc ? sc.split(';')[0] : null };
+}
+const signIn = async (employeeId, password, portal) => (await call('POST', '/api/auth/login', { body: portal ? { employeeId, password, portal } : { employeeId, password } })).cookie;
+
+test('HTTP: no session -> 401, a BDE -> 403 (nothing written); the admin gets 200 with the interview', async () => {
+  const url = '/api/admin/interviews/1/attendance';
+  const none = await call('PUT', url, { body: { attendance: 'attended' } });
+  assert.equal(none.status, 401); assert.equal(none.json.error.code, 'UNAUTHENTICATED');
+  const b = await call('PUT', url, { body: { attendance: 'attended' }, cookie: await signIn('BDE-10', 'bde-password-10') });
+  assert.equal(b.status, 403); assert.deepEqual(repo.writes, []);
