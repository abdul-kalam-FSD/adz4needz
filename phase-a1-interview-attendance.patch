+});
+
+test('HTTP: other methods on the path write nothing, the existing admin reads still need an admin, and the BDE route for the same interview is unchanged', async () => {
+  const bdeCookie = await signIn('BDE-10', 'bde-password-10');
+  const adminCookie = await signIn('ADM-1', 'admin-password-1', 'admin');
+  const before = JSON.stringify(repo.rows);
+  for (const method of ['POST', 'PATCH', 'DELETE']) { const r = await call(method, '/api/admin/interviews/1/attendance', { body: { attendance: 'did_not_attend' }, cookie: adminCookie }); assert.ok(r.status >= 400, method); }
+  assert.equal(JSON.stringify(repo.rows), before);
+  assert.equal((await call('GET', '/api/admin/interviews/1', { cookie: bdeCookie })).status, 403);
+  assert.equal((await call('GET', '/api/admin/interviews/1', { cookie: adminCookie })).status, 200);
+  const full = { scheduledAt: '2026-10-18T11:00', attendance: 'attended', outcome: 'pending', interestedInJoining: null };
+  assert.equal((await call('PUT', '/api/interviews/1', { body: full, cookie: bdeCookie })).status, 200, 'the owning BDE still edits through the BDE route');
+  assert.equal((await call('PUT', '/api/interviews/1', { body: full, cookie: adminCookie })).status, 403, 'the admin still cannot use the BDE edit route');
+});
