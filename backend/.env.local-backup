# Copy this file to .env and fill in YOUR values. Never commit .env.
# Placeholders below are NOT real credentials.
NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bde_app
DB_PASSWORD=tomholland@3636
DB_NAME=bde_team_management
# Login session length in hours (default 8). Final value needs TL confirmation.
SESSION_TTL_HOURS=8
# Rate limit per 15 minutes, used by TWO endpoints: login attempts (counted per IP address) and
# password-change attempts, POST /api/profile/password (counted per logged-in user). Counters are kept in memory.
LOGIN_RATE_LIMIT_MAX=10
# Set to 1 only when running behind a reverse proxy (nginx etc.)
TRUST_PROXY=0

# Payment proof (receipt / screenshot) files. See docs/payments-and-uploads.md.
# Folder where uploaded files are stored. It must be OUTSIDE any folder a web server publishes, readable and writable only
# by the account that runs this API. Use an absolute path in production. If unset, backend/storage/receipts is used (development only).
RECEIPT_STORAGE_DIR=B:\Internship\Projects\New folder\Receipt
# Largest accepted file in bytes (default 5242880 = 5 MB; allowed 1024 to 20971520). Your reverse proxy must allow at least this much.
RECEIPT_MAX_BYTES=5242880

# Largest accepted Excel/CSV lead-import file in bytes (default 5242880 = 5 MB; allowed 10240 to 20971520).
IMPORT_MAX_BYTES=5242880
