/* ADZ4NEEDZ BDE Tracker. Plain CSS, no external resources. Base copied from the approved bde-tracker prototype. */

:root {
  --bg: #f5f6f8;
  --surface: #ffffff;
  --text: #1f2937;
  --muted: #5b6472;
  --border: #cfd5dd;
  --primary: #1d4ed8;
  --primary-dark: #1e40af;
  --error: #b42318;
  --error-bg: #fef3f2;
  --success: #176448;
  --success-bg: #ecfdf3;
  --info-bg: #eff4ff;
  --info-border: #b2c7f5;
  --info-text: #1e3a8a;
  --topbar-height: 56px;
  --sidebar-width: 220px;
}

*, *::before, *::after { box-sizing: border-box; }

html { font-size: 100%; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  line-height: 1.5;
}

:focus-visible {
  outline: 3px solid #f59e0b;
  outline-offset: 2px;
}

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  background: var(--surface);
  color: var(--primary);
  padding: 8px 12px;
  z-index: 100;
}
.skip-link:focus { left: 8px; top: 8px; }

[hidden] { display: none !important; }

/* ---------- Top bar ---------- */
.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12px;
  height: var(--topbar-height);
  padding: 0 16px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}

.brand { font-weight: 700; font-size: 1.125rem; }

.topbar-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12px;
}

.user { display: flex; align-items: center; gap: 8px; }
.user-name { font-weight: 600; }


.menu-button { display: none; }

/* ---------- Layout and sidebar ---------- */
.layout { display: flex; min-height: calc(100vh - var(--topbar-height)); }

.sidebar {
  flex: 0 0 var(--sidebar-width);
  background: var(--surface);
  border-right: 1px solid var(--border);
  padding: 12px 0;
}
.sidebar ul { list-style: none; margin: 0; padding: 0; }

.nav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-height: 44px;
  padding: 8px 16px;
  color: var(--text);
  text-decoration: none;
}
a.nav-item:hover { background: var(--bg); }

.nav-item.is-current {
  font-weight: 600;
  color: var(--primary);
  background: var(--info-bg);
  border-left: 4px solid var(--primary);
  padding-left: 12px;
}

.nav-item.is-disabled { color: var(--muted); cursor: not-allowed; }

.soon {
  font-size: 0.75rem;
  color: var(--muted);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 0 6px;
  white-space: nowrap;
}

/* ---------- Content ---------- */
.content { flex: 1; min-width: 0; padding: 24px; }
.content h1 { margin: 0 0 16px; font-size: 1.5rem; }

.notice {
  max-width: 560px;
  margin: 0 0 20px;
  padding: 10px 14px;
  background: var(--info-bg);
  border: 1px solid var(--info-border);
  border-radius: 4px;
  color: var(--info-text);
}

.report-form {
  max-width: 560px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 20px;
}

.field { margin-bottom: 16px; }

.field label { display: block; margin-bottom: 4px; font-weight: 600; }

.field input[type="text"],
.field input[type="date"] {
  display: block;
  width: 100%;
  min-height: 44px;
  padding: 8px 12px;
  font: inherit;
  color: var(--text);
  background: var(--surface);
  border: 1px solid #8a93a1;
  border-radius: 4px;
}

.field input[aria-invalid="true"] {
  border-color: var(--error);
  box-shadow: inset 0 0 0 1px var(--error);
}

.hint { margin: 0 0 12px; color: var(--muted); font-size: 0.9rem; }

.field-error {
  margin: 4px 0 0;
  color: var(--error);
  font-size: 0.9rem;
}

/* ---------- Buttons ---------- */
.btn {
  min-height: 44px;
  padding: 8px 18px;
  font: inherit;
  font-weight: 600;
  border-radius: 4px;
  border: 1px solid transparent;
  cursor: pointer;
}
.btn:disabled { cursor: not-allowed; opacity: 0.6; }

.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover:not(:disabled) { background: var(--primary-dark); }

.btn-secondary { background: var(--surface); color: var(--text); border-color: #8a93a1; }
.btn-secondary:hover:not(:disabled) { background: var(--bg); }

.btn-quiet {
  background: var(--surface);
  color: var(--muted);
  border-color: var(--border);
  min-height: 36px;
  padding: 4px 12px;
  font-weight: 500;
}

.menu-button {
  min-height: 40px;
  padding: 4px 12px;
  font: inherit;
  font-weight: 600;
  background: var(--surface);
  border: 1px solid #8a93a1;
  border-radius: 4px;
  cursor: pointer;
}

.actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

/* ---------- Messages ---------- */
.alert {
  margin-top: 16px;
  padding: 10px 14px;
  border-radius: 4px;
  border: 1px solid var(--border);
  border-left-width: 4px;
}
.alert p { margin: 0; }
.alert ul { margin: 6px 0 0; padding-left: 20px; }
.alert a { color: inherit; }

.alert-error {
  background: var(--error-bg);
  border-color: var(--error);
  color: var(--error);
}
.alert-success {
  background: var(--success-bg);
  border-color: var(--success);
  color: var(--success);
}
#error-summary { margin: 0 0 16px; }
.alert-title { font-weight: 700; }

/* ---------- Responsive ---------- */
@media (max-width: 768px) {
  .menu-button { display: inline-block; }
  .user-name { font-size: 0.9rem; }

  .sidebar {
    display: none;
    position: fixed;
    top: var(--topbar-height);
    left: 0;
    bottom: 0;
    z-index: 15;
    width: min(280px, 85vw);
    overflow-y: auto;
    box-shadow: 2px 0 6px rgba(0, 0, 0, 0.15);
  }
  body.sidebar-open .sidebar { display: block; }

  .content { padding: 16px; }
  .report-form { padding: 16px; }
  .actions .btn { flex: 1 1 140px; }
}

@media (max-width: 480px) {
  /* Two-row top bar: menu + brand on row 1, user on row 2 */
  :root { --topbar-height: 88px; }
  .topbar { flex-wrap: wrap; align-content: center; row-gap: 4px; gap: 8px; padding: 6px 12px; }
  .topbar-right { margin-left: 0; width: 100%; }
  .user { flex-direction: row; align-items: center; gap: 8px; }
  .user-name { white-space: nowrap; }
  .brand { font-size: 1rem; }
}

@media (prefers-reduced-motion: reduce) {
  * { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
}

/* ---------- Added for the real application ---------- */
@media (max-width: 768px) {
  .sidebar.is-open { display: block; }
}

.login-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 16px; }
.login-card {
  width: 100%; max-width: 400px; background: var(--surface);
  border: 1px solid var(--border); border-radius: 6px; padding: 24px;
}
.login-card h1 { margin: 0 0 4px; font-size: 1.25rem; }
.login-card .subtitle { margin: 0 0 20px; color: var(--muted); }
.login-card .btn { width: 100%; margin-top: 4px; }
.login-card .alert { margin: 0 0 16px; }

.reports-section { max-width: 900px; margin-top: 28px; }
.reports-section h2 { margin: 0 0 8px; font-size: 1.125rem; }
.table-wrap { overflow-x: auto; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; }
.table-wrap table { border-collapse: collapse; width: 100%; min-width: 600px; }
.table-wrap th, .table-wrap td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border); }
.table-wrap th { background: var(--bg); font-weight: 600; font-size: 0.9rem; }
.table-wrap tr:last-child td { border-bottom: 0; }
.table-wrap .num { text-align: right; }
.state-message { margin: 0; padding: 14px; color: var(--muted); }
.fullpage-message { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 16px; text-align: center; }

/* ---------- Admin screens ---------- */
.toolbar { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px; margin-bottom: 8px; }
.toolbar .field { margin-bottom: 8px; min-width: 200px; }
.totals {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px;
  margin: 12px 0 0; max-width: 900px;
}
.total-item { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; }
.total-item dt { color: var(--muted); font-size: 0.85rem; }
.total-item dd { margin: 2px 0 0; font-size: 1.5rem; font-weight: 700; }
.section-title { margin: 24px 0 8px; font-size: 1.125rem; }
.muted { color: var(--muted); }
.table-wrap a, .content > p > a { color: var(--primary); }
.content > .state-message { padding-left: 0; }

/* ---------- Leads ---------- */
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.page-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.page-head h1 { margin: 0; }
.btn-as-link { display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
.btn-link { background: none; border: 0; padding: 0; font: inherit; color: inherit; text-decoration: underline; cursor: pointer; }

.followup-summary { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
.summary-button {
  min-height: 44px; padding: 8px 14px; font: inherit; color: var(--text); background: var(--surface);
  border: 1px solid #8a93a1; border-radius: 4px; cursor: pointer;
}
.summary-button:hover { background: var(--bg); }
.summary-button .n { font-weight: 700; font-size: 1.125rem; margin-right: 4px; }

.filters {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0 16px; align-items: end;
  background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 16px 16px 4px; margin-bottom: 16px; max-width: 1000px;
}
.filters .field input, .filters .field select { display: block; width: 100%; min-height: 44px; padding: 8px 12px; font: inherit; color: var(--text); background: var(--surface); border: 1px solid #8a93a1; border-radius: 4px; }
.filter-actions { display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
.filters .field-error { grid-column: 1 / -1; margin: -8px 0 12px; }

.field select, .field textarea {
  display: block; width: 100%; min-height: 44px; padding: 8px 12px; font: inherit; color: var(--text);
  background: var(--surface); border: 1px solid #8a93a1; border-radius: 4px;
}
.field textarea { resize: vertical; }
.field select[aria-invalid="true"], .field textarea[aria-invalid="true"] { border-color: var(--error); box-shadow: inset 0 0 0 1px var(--error); }
.hint-inline { margin: 4px 0 0; color: var(--muted); font-size: 0.85rem; }

.badge { display: inline-block; margin-left: 8px; padding: 0 6px; font-size: 0.75rem; font-weight: 600; border-radius: 4px; border: 1px solid; white-space: nowrap; }
.badge-overdue { color: var(--error); background: var(--error-bg); border-color: var(--error); }
.badge-today { color: #92400e; background: #fffbeb; border-color: #b45309; }
.badge-upcoming { color: var(--info-text); background: var(--info-bg); border-color: var(--info-border); }
.clip { max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.alert-warning { background: #fffbeb; border-color: #b45309; color: #78350f; }
.alert-warning .actions { margin-top: 12px; }
.alert-success .btn-link { margin-left: 8px; }

.pager { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 12px; }
.table-wrap td:first-child { font-weight: 600; }
.table-wrap a { text-underline-offset: 2px; }
.table-wrap table { min-width: 760px; }

/* Interviews */
.badge-success { color: var(--success); background: var(--success-bg); border-color: var(--success); }
.badge-muted { color: var(--muted); background: var(--bg); border-color: var(--border); margin-left: 0; }
.field input[type="datetime-local"] { display: block; width: 100%; min-height: 44px; padding: 8px 12px; font: inherit; color: var(--text); background: var(--surface); border: 1px solid #8a93a1; border-radius: 4px; }
.field input[type="datetime-local"][aria-invalid="true"] { border-color: var(--error); box-shadow: inset 0 0 0 1px var(--error); }
.filters .field input[type="date"] { min-height: 44px; }
.check-row { display: flex; align-items: center; gap: 8px; font-weight: 600; }
.check-row input { width: 20px; height: 20px; }
.lead-box { margin: 0 0 16px; padding: 12px; background: var(--info-bg); border: 1px solid var(--info-border); border-radius: 6px; color: var(--info-text); }
.lead-box p { margin: 0; }
.overview-title { margin: 24px 0 8px; font-size: 1.1rem; }
.table-wrap tfoot td { font-weight: 700; background: var(--bg); }

/* Payments */
.totals-grid { display: flex; flex-wrap: wrap; gap: 12px; margin: 0 0 16px; }
.total-card { flex: 1 1 160px; padding: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; }
.total-card .n { display: block; font-size: 1.25rem; font-weight: 700; }
.total-card .l { color: var(--muted); font-size: 0.875rem; }
.table-wrap td.num, .table-wrap th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
.label-text { display: block; font-weight: 600; margin-bottom: 4px; }
.inline-form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; margin: 12px 0; }
.inline-form .field { flex: 1 1 160px; margin: 0; }
.receipt-list { margin: 4px 0 0; padding-left: 20px; }
.card { margin: 16px 0; padding: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; }
.card h2 { margin-top: 0; font-size: 1.1rem; }

/* Profile */
.field input[type="email"],
.field input[type="tel"],
.field input[type="password"] { display: block; width: 100%; min-height: 44px; padding: 8px 12px; font: inherit; color: var(--text); background: var(--surface); border: 1px solid #8a93a1; border-radius: 4px; }
.profile-details { margin: 0; display: grid; gap: 8px; }
.profile-details div { display: flex; flex-wrap: wrap; gap: 4px 16px; }
.profile-details dt { min-width: 120px; font-weight: 600; color: var(--muted); }
.profile-details dd { margin: 0; }
.report-form + .report-form { margin-top: 24px; }
.profile-card .section-title { margin-top: 0; } /* first heading in a card: no extra gap above it */

/* ---------- Chat ---------- */
.chat { display: grid; grid-template-columns: 280px 1fr; gap: 16px; align-items: stretch; height: calc(100vh - var(--topbar-height) - 110px); min-height: 420px; }
.chat-list, .chat-pane { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; display: flex; flex-direction: column; min-height: 0; }
.chat-list { overflow-y: auto; }
.chat-list ul { list-style: none; margin: 0; padding: 0; }
.chat-item { position: relative; display: block; width: 100%; text-align: left; padding: 10px 44px 10px 14px; font: inherit; color: var(--text); background: none; border: 0; border-bottom: 1px solid var(--border); cursor: pointer; min-height: 52px; }
.chat-item:hover { background: var(--bg); }
.chat-item.is-current { background: var(--info-bg); box-shadow: inset 3px 0 0 var(--primary); }
.chat-item-name { display: block; font-weight: 600; }
.chat-item-sub { display: block; font-size: 0.85rem; color: var(--muted); }
.chat-badge { display: inline-block; min-width: 22px; padding: 1px 6px; margin-left: 8px; border-radius: 11px; background: var(--primary); color: #fff; font-size: 0.78rem; font-weight: 700; line-height: 1.5; text-align: center; }
.chat-item .chat-badge { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); margin: 0; }
.chat-head { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-bottom: 1px solid var(--border); }
.chat-back { display: none; }
.chat-log { flex: 1; min-height: 0; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; background: var(--bg); }
.chat-msg { align-self: flex-start; max-width: min(75%, 560px); background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 8px 12px; }
.chat-msg.is-mine { align-self: flex-end; background: var(--info-bg); border-color: var(--info-border); }
.chat-msg-from { font-size: 0.8rem; font-weight: 600; margin-bottom: 2px; }
.chat-msg-body { white-space: pre-wrap; overflow-wrap: anywhere; }
.chat-msg-time { font-size: 0.75rem; margin-top: 2px; text-align: right; }
.chat-compose { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 14px; border-top: 1px solid var(--border); background: var(--surface); }
.chat-compose .field-error { flex-basis: 100%; margin: 0; }
.chat-compose textarea { flex: 1; min-width: 0; font: inherit; padding: 8px 10px; border: 1px solid #8a93a1; border-radius: 4px; resize: none; }
.chat-empty { margin: auto; padding: 24px; text-align: center; }

@media (max-width: 768px) {
  .chat { grid-template-columns: 1fr; height: calc(100vh - var(--topbar-height) - 90px); }
  .chat .chat-pane { display: none; }
  .chat.chat-open .chat-list { display: none; }
  .chat.chat-open .chat-pane { display: flex; }
  .chat-back { display: inline-flex; }
  .chat-msg { max-width: 88%; }
}

/* ---------- Lead list: inline status ---------- */
.status-select { font: inherit; max-width: 100%; padding: 4px 6px; border: 1px solid #8a93a1; border-radius: 4px; background: var(--surface); color: var(--text); min-height: 36px; }
.status-select:disabled { opacity: 0.6; cursor: progress; }
